{
  "name": "rex-gui",
  "version": "1.0.0",
  "description": "AskRex Assistant desktop GUI",
  "main": "./dist-electron/main/index.js",
  "author": "AskRex",
  "homepage": ".",
  "repository": "https://github.com/Blueibear/AskRex-Assistant.git",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "runtime:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_managed_python_runtime.ps1 -Profile Voice",
    "runtime:build:core": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_managed_python_runtime.ps1 -Profile Core",
    "predist": "npm run runtime:build && npm run build",
    "dist": "electron-builder --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "install-electron --no"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/inter": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "esbuild": "0.28.1",
    "brace-expansion": "5.0.9"
  },
  "build": {
    "appId": "com.askrex.app",
    "productName": "AskRex",
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets/brand",
        "to": "assets/brand"
      },
      {
        "from": "../bridge",
        "to": "bridge",
        "filter": [
          "*.py",
          "README.md"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "autonomy.json",
          "rex_config.example.json",
          "rex_config.schema.json",
          "triage_rules.json"
        ]
      },
      {
        "from": "runtime/python",
        "to": "python"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "include": "nsis/installer.nsh"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "next_action",
    "needs_user",
    "blocker_reason",
    "task_id",
    "task_prompt",
    "role",
    "invocation_id",
    "coordination_messages",
    "issue_updates"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "continue",
        "ready_for_review",
        "pass",
        "changes_required",
        "assign",
        "done",
        "blocked_user",
        "blocked_system",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "needs_user": {
      "type": "boolean"
    },
    "blocker_reason": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_prompt": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "invocation_id": {
      "type": "string"
    },
    "coordination_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "priority",
          "related",
          "needs_response",
          "body"
        ],
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "backend",
              "mobile",
              "testing",
              "supervisor"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "critical"
            ]
          },
          "related": {
            "type": "string"
          },
          "needs_response": {
            "type": "boolean"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "issue_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "status",
          "note"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed-needs-retest"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}

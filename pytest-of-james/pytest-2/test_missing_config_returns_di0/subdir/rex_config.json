    "llm_backend": null,
    "llm_max_tokens": 120,
    "llm_model": "sshleifer/tiny-gpt2",
    "llm_provider": "transformers",
    "llm_seed": 42,
    "llm_temperature": 0.7,
    "llm_top_k": 50,
    "llm_top_p": 0.9,
    "stt_device": "cpu",
